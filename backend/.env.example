# Backend Environment Variables Example
# Copy this to .env and update the values

# Database Configuration
# For local development with SQLite (no setup needed):
DATABASE_URL=sqlite:///./cloud_optimization.db

# For PostgreSQL (requires running PostgreSQL):
# DATABASE_URL=postgresql://admin:admin@localhost:5432/cloud_db

# For Docker (when running with docker-compose):
# DATABASE_URL=postgresql://admin:admin@db:5432/cloud_db

# API Keys (sign up at respective services)
OPENAI_API_KEY=your-openai-api-key-here
SENDGRID_API_KEY=your-sendgrid-api-key-here

# Email Configuration
EMAIL_FROM=alerts@cloudoptimization.com
ADMIN_EMAIL=admin@example.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Application Settings
DEBUG=True
