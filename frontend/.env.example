# Frontend Environment Variables Example
# Copy this to .env and update the values

# API URL - Backend endpoint
REACT_APP_API_URL=http://localhost:8000/api

# Feature flags
REACT_APP_ENABLE_EMAIL_ALERTS=true
REACT_APP_ENABLE_AI_ANALYSIS=true

# Polling intervals (in seconds)
REACT_APP_METRICS_REFRESH_INTERVAL=30
REACT_APP_HEALTH_CHECK_INTERVAL=60
